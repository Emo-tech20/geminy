# Server Configuration
# For local development: http://localhost:3000
# For Vercel production: https://your-app.vercel.app
CLIENT_URL=http://localhost:3000
NODE_ENV=development

# Optional: PORT (Vercel automatically sets this to 3000+)
# PORT=3000

# Supabase Configuration
# Get these from your Supabase project dashboard:
# - SUPABASE_URL: Go to Settings → API → Project URL
# - SUPABASE_ANON_KEY: Go to Settings → API → Project API keys (anon/public)
# - SUPABASE_SERVICE_ROLE_KEY: Go to Settings → API → Project API keys (service_role)
# - SUPABASE_JWKS_URL: Usually https://[your-project].supabase.co/auth/v1/.well-known/jwks.json
SUPABASE_URL=your-supabase-url-here
SUPABASE_ANON_KEY=your-supabase-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-here
SUPABASE_JWKS_URL=your-supabase-jwks-url-here

# AI Provider Configuration - Google Gemini
# Get from https://ai.google.dev/
# 1. Create a Google account with API key access
# 2. Generate an API key from Google AI Studio
# 3. Paste here (keep this SECRET, never commit to Git)
GEMINI_API_KEY=AQ.Ab8RN6KAVp6L4aQRB_EyhkRDY57I_N-3hDtEGTpqvNCcNUGjAg